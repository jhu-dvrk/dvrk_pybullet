{
  "$id": "dvrk-system.schema.json",
  "$version": "1",
  "component_manager": {
    "components": [
      {
        "shared-library": "saw3Dconnexion",
        "class-name": "mts3Dconnexion",
        "constructor-arg": {"Name": "SpaceMouseLeft"},
        "configure-parameter": "saw3Dconnexion-MTML.json"
      },
      {
        "shared-library": "saw3Dconnexion",
        "class-name": "mts3Dconnexion",
        "constructor-arg": {"Name": "SpaceMouseRight"},
        "configure-parameter": "saw3Dconnexion-MTMR.json"
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_psm_from_ros",
        "constructor-arg": {"Name": "PSM1", "Period": 0.01}
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_psm_from_ros",
        "constructor-arg": {"Name": "PSM2", "Period": 0.01}
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_psm_from_ros",
        "constructor-arg": {"Name": "PSM3", "Period": 0.01}
      },
      {
        "shared-library": "dvrk_arm_from_ros",
        "class-name": "dvrk_arm_from_ros",
        "constructor-arg": {"Name": "ECM", "Period": 0.01}
      }
    ]
  },
  "arms": [
    {
      "name": "MTML",
      "type": "MTM_GENERIC",
      "component": "SpaceMouseLeft",
      "interface": "MTML"
    },
    {
      "name": "MTMR",
      "type": "MTM_GENERIC",
      "component": "SpaceMouseRight",
      "interface": "MTMR"
    },
    {"name": "PSM1", "type": "PSM_GENERIC", "component": "PSM1", "interface": "PSM1", "skip_ROS_bridge": true},
    {"name": "PSM2", "type": "PSM_GENERIC", "component": "PSM2", "interface": "PSM2", "skip_ROS_bridge": true},
    {"name": "PSM3", "type": "PSM_GENERIC", "component": "PSM3", "interface": "PSM3", "skip_ROS_bridge": true},
    {"name": "ECM", "type": "ECM_GENERIC", "component": "ECM", "interface": "ECM", "skip_ROS_bridge": true}
  ],
  "consoles": [
    {
      "name": "console",
      "input_type": "SIMULATED",
      "teleop_PSMs": [
        {
          "MTM": "MTMR",
          "PSM": "PSM1",
          "configure_parameter": {
            "MTM_is_haptic": false,
            "align_MTM": false,
            "use_MTM_linear_velocity": false,
            "use_MTM_angular_velocity": false,
            "ignore_jaw": false,
            "start_gripper_threshold": 0.0,
            "scale": 0.3
          }
        },
        {
          "MTM": "MTML",
          "PSM": "PSM2",
          "configure_parameter": {
            "MTM_is_haptic": false,
            "align_MTM": false,
            "use_MTM_linear_velocity": false,
            "use_MTM_angular_velocity": false,
            "ignore_jaw": false,
            "start_gripper_threshold": 0.0,
            "scale": 0.3
          }
        },
        {
          "MTM": "MTML",
          "PSM": "PSM3",
          "configure_parameter": {
            "MTM_is_haptic": false,
            "align_MTM": false,
            "use_MTM_linear_velocity": false,
            "use_MTM_angular_velocity": false,
            "ignore_jaw": false,
            "start_gripper_threshold": 0.0,
            "scale": 0.3
          }
        }
      ],
      "teleop_ECMs": [
        {
          "MTML": "MTML",
          "MTMR": "MTMR",
          "ECM": "ECM",
          "configure_parameter": {
            "MTM_is_haptic": false,
            "check_MTMs_workspace": false,
            "haptic_feedback_ratio": 0.0
          }
        }
      ]
    }
  ]
}
